FROM node:22-alpine AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_MAPTILER_KEY=""
ARG VITE_MAP_STYLE_URL=""
RUN npm run build

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/app/.venv/bin:$PATH"
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN pip install uv==0.12.5 && uv sync --frozen --no-dev && \
    useradd --system --home /app --shell /usr/sbin/nologin livemap
COPY alembic.ini ./
COPY alembic ./alembic
COPY demo ./demo
COPY deploy/certs ./deploy/certs
COPY scripts/render-start.sh ./scripts/render-start.sh
COPY --from=frontend /frontend/dist ./frontend-dist
USER livemap
EXPOSE 10000
CMD ["sh", "/app/scripts/render-start.sh"]
